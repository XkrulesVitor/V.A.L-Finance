# Modelo. Copie para backend/.env e preencha la -- este arquivo vai pro
# git, o .env nao. Nunca coloque chave de verdade aqui.

# Binance testnet (https://testnet.binance.vision).
# Nao sao as chaves da conta real. O backtest nao precisa delas:
# historico de preco e endpoint publico.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Supabase -- Project Settings > API.
# A URL e https://<project_ref>.supabase.co (so a origem, sem caminho).
SUPABASE_URL=

# A chave SECRETA do backend: ignora RLS pra poder escrever.
# O Supabase renomeou o formato -- o painel novo entrega
# SUPABASE_SECRET_KEY (sb_secret_...), projetos antigos tem
# SUPABASE_SERVICE_ROLE_KEY (um JWT longo). O codigo aceita as duas;
# preencha a que o seu painel mostrar.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# A chave PUBLICA (sb_publishable_... ou a anon antiga) e do FRONTEND,
# e vai em frontend/.env.local -- nao e usada pelo backend.
# SUPABASE_ANON_KEY=

# ---- Cerebro (LLM) ----
# Qual provedor usar. O codigo aceita 'gemini' e 'claude'; adicionar um
# terceiro e uma classe em backend/brain/provedores.py.
LLM_PROVEDOR=gemini

# Opcional: sobrescreve o modelo padrao de qualquer provedor.
# LLM_MODELO=

# Gemini (https://aistudio.google.com/apikey). Free tier, sem cartao:
# 500 requisicoes/dia por modelo, ~15/min (medido -- ver secao 8).
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.1-flash-lite

# Anthropic (https://console.anthropic.com). NAO tem free tier -- e
# pre-pago. O padrao do codigo e claude-opus-5; para esta tarefa o
# claude-haiku-4-5 custa ~5x menos e provavelmente basta.
# ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-haiku-4-5

# OpenRouter: chave para o painel de IAs (so modelos ':free')
OPENROUTER_API_KEY=
